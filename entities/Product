{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Inverter",
        "Battery",
        "Accessory"
      ],
      "default": "Inverter"
    },
    "brand": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Price in PKR"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "description": "Image URL"
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ]
}